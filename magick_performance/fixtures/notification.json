  "message": "<p>Dear {{ doc.employee_name }} ({{ doc.nickname }}),</p>\r\n<p>\r\n    Your Performance Evaluation for the <strong>{{ doc.cycle_year }}</strong> \r\n    performance cycle has been <strong style=\"color:#16a34a;\">finalized</strong> \r\n    by your Line Manager.\r\n</p>\r\n\r\n<!-- Finalized Confirmation Box -->\r\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 16px 0;\">\r\n    <tr>\r\n        <td style=\"background:#f0fdf4; border-left:4px solid #16a34a; \r\n                   border-radius:4px; padding:16px 20px;\">\r\n            <p style=\"margin:0 0 6px; font-size:12px; \r\n                      color:#16a34a; font-weight:600; letter-spacing:0.5px;\">\r\n                FINALIZED\r\n            </p>\r\n            <p style=\"margin:0; font-size:14px; color:#1f2937; line-height:1.6;\">\r\n                Your evaluation for the <strong>{{ doc.cycle_year }}</strong> cycle \r\n                is now complete. Below is a summary of your final scores.\r\n            </p>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<p>Here is a summary of your evaluation scores:</p>\r\n\r\n<!-- Score Summary Table -->\r\n<table style=\"border-collapse:collapse; width:100%; font-size:13px;\">\r\n    <thead>\r\n        <tr style=\"background:#1e3a5f; color:#fff;\">\r\n            <th style=\"padding:8px 12px; text-align:left;\">Section</th>\r\n            <th style=\"padding:8px 12px; text-align:center;\">Score</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        <tr style=\"border-bottom:1px solid #e5e7eb;\">\r\n            <td style=\"padding:8px 12px; color:#374151;\">Goal Progression Score</td>\r\n            <td style=\"padding:8px 12px; text-align:center; color:#374151;\">\r\n                {{ doc.total_goal_score }} / 5\r\n            </td>\r\n        </tr>\r\n        <tr style=\"border-bottom:1px solid #e5e7eb;\">\r\n            <td style=\"padding:8px 12px; color:#374151;\">Self Review Score</td>\r\n            <td style=\"padding:8px 12px; text-align:center; color:#374151;\">\r\n                {{ doc.total_self_score }} / 5\r\n            </td>\r\n        </tr>\r\n        <tr style=\"border-bottom:1px solid #e5e7eb;\">\r\n            <td style=\"padding:8px 12px; color:#374151;\">Manager Review Score</td>\r\n            <td style=\"padding:8px 12px; text-align:center; color:#374151;\">\r\n                {{ doc.total_manager_score }} / 5\r\n            </td>\r\n        </tr>\r\n        <tr style=\"background:#f8fafc;\">\r\n            <td style=\"padding:10px 12px; font-weight:700; color:#1e3a5f;\">\r\n                Final Score\r\n            </td>\r\n            <td style=\"padding:10px 12px; text-align:center; font-weight:700; \r\n                       font-size:15px; color:#1e3a5f;\">\r\n                {{ doc.final_score }} / 5\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<br>\r\n\r\n<!-- CTA Button -->\r\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\r\n    <tr>\r\n        <td align=\"center\" style=\"padding: 24px 0;\">\r\n            <table cellpadding=\"0\" cellspacing=\"0\">\r\n                <tr>\r\n                    <td style=\"border-radius:8px; background:#1e3a5f;\">\r\n                        <a href=\"{{ frappe.utils.get_url() }}/app/performance-evaluation/{{ doc.name }}\"\r\n                           style=\"display:inline-block; padding:14px 32px; \r\n                                  font-size:15px; font-weight:600;\r\n                                  color:#ffffff; text-decoration:none;\r\n                                  border-radius:8px; letter-spacing:0.3px;\">\r\n                            📋 &nbsp; View My Evaluation\r\n                        </a>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n            <p style=\"margin-top:10px; font-size:11px; color:#9ca3af;\">\r\n                Or copy this link to your browser:<br>\r\n                <span style=\"color:#1e3a5f;\">\r\n                    {{ frappe.utils.get_url() }}/app/performance-evaluation/{{ doc.name }}\r\n                </span>\r\n            </p>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<p>\r\n    If you have any questions regarding your evaluation results, please contact \r\n    your Line Manager directly.\r\n</p>\r\n<p style=\"color:#6b7280; font-size:12px; margin-top:24px; \r\n          border-top:1px solid #e5e7eb; padding-top:12px;\">\r\n    This is an automated notification. Please do not reply to this email.\r\n</p>",
